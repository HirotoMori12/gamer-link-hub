<div class="min-h-screen bg-gray-50 py-8 px-4">
  <div class="max-w-4xl mx-auto">
    <div class="mb-6">
      <%= link_to "← 投稿一覧に戻る", posts_path, class: "text-indigo-600 hover:underline" %>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <!-- タグ表示 -->
      <% if @post.tags.any? %>
        <div class="mb-4">
          <% @post.tags.each do |tag| %>
            <span class="inline-block px-3 py-1 bg-indigo-100 text-indigo-700 text-sm rounded mr-1"><%= tag.name %></span>
          <% end %>
        </div>
      <% end %>

      <!-- 画像ギャラリー -->
      <% attached_images = @post.attached_images.attached? ? @post.attached_images : [] %>
      <% legacy_images = @post.images %>

      <% if attached_images.any? || legacy_images.any? %>
        <div class="mb-6">
          <h2 class="text-sm font-medium text-gray-600 mb-3">画像 (<%= attached_images.size + legacy_images.size %>枚)</h2>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
            <% attached_images.each do |img| %>
              <div class="aspect-square bg-gray-100 rounded overflow-hidden">
                <%= image_tag url_for(img), class: "w-full h-full object-cover" %>
              </div>
            <% end %>
            <% legacy_images.each do |img| %>
              <div class="aspect-square bg-gray-100 rounded overflow-hidden">
                <%= image_tag img.image_url, class: "w-full h-full object-cover" %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- 本文 -->
      <div class="mb-6">
        <h2 class="text-sm font-medium text-gray-600 mb-2">本文</h2>
        <div class="bg-gray-50 rounded p-4 text-gray-800 whitespace-pre-wrap"><%= auto_link_urls(@post.body) %></div>
      </div>

      <!-- 関連投稿 -->
      <% if @post.related_posts.any? %>
        <div class="mb-6">
          <h2 class="text-sm font-medium text-gray-600 mb-3">関連投稿 (<%= @post.related_posts.size %>件)</h2>
          <div class="space-y-2">
            <% @post.related_posts.each do |related| %>
              <%= link_to post_path(related), class: "block bg-gray-50 border border-gray-200 rounded p-3 hover:bg-gray-100 transition" do %>
                <p class="text-sm text-gray-800 mb-1"><%= truncate(related.body, length: 60) %></p>
                <% if related.tags.any? %>
                  <div>
                    <% related.tags.each do |tag| %>
                      <span class="inline-block px-2 py-1 bg-indigo-100 text-indigo-700 text-xs rounded mr-1"><%= tag.name %></span>
                    <% end %>
                  </div>
                <% end %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- メタ情報 -->
      <div class="border-t pt-4 text-sm text-gray-500 flex items-center justify-between">
        <span>投稿者: <%= @post.user.username %></span>
        <span><%= @post.created_at.strftime("%Y/%m/%d %H:%M") %></span>
      </div>

      <!-- 編集・削除ボタン(本人の投稿のみ) -->
      <% if @is_owner %>
        <div class="border-t mt-4 pt-4 flex gap-2">
          <%= link_to "編集", edit_post_path(@post), class: "px-4 py-2 bg-indigo-600 text-white rounded hover:bg-indigo-700" %>
          <%= button_to "削除", post_path(@post), method: :delete, data: { turbo: false, confirm: "本当に削除しますか?" }, class: "px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
