<div class="min-h-screen bg-gray-50 py-8 px-4">
  <div class="max-w-6xl mx-auto">
    <div class="mb-6 flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-800">投稿一覧</h1>
        <p class="text-gray-600 mt-1">サーバー: <%= current_guild.name %></p>
      </div>
      <div class="space-x-2">
        <%= link_to "サーバー選択", guilds_path, class: "inline-block px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300" %>
        <%= button_to "ログアウト", sign_out_path, method: :delete, data: { turbo: false }, class: "inline-block px-4 py-2 bg-gray-300 text-gray-800 rounded hover:bg-gray-400" %>
      </div>
    </div>

    <!-- 検索フォーム -->
    <div class="bg-white rounded-lg shadow p-4 mb-6">
      <%= form_with url: posts_path, method: :get, local: true, class: "space-y-3" do |f| %>
        <div class="flex gap-2">
          <%= f.text_field :keyword, value: params[:keyword], placeholder: "キーワードで検索(本文・タグ)", class: "flex-1 px-3 py-2 border border-gray-300 rounded" %>
          <%= f.submit "検索", class: "px-6 py-2 bg-indigo-600 text-white rounded hover:bg-indigo-700 cursor-pointer" %>
        </div>

        <% if @tags.any? %>
          <div>
            <label class="text-sm text-gray-600 mr-2">タグ絞り込み:</label>
            <%= f.select :tag_id,
                options_for_select(@tags.map { |t| [t.name, t.id] }, params[:tag_id]),
                { include_blank: "全て" },
                class: "px-3 py-1 border border-gray-300 rounded" %>
          </div>
        <% end %>

        <% if params[:keyword].present? || params[:tag_id].present? %>
          <div>
            <%= link_to "検索条件をクリア", posts_path, class: "text-sm text-indigo-600 hover:underline" %>
          </div>
        <% end %>
      <% end %>
    </div>

    <!-- 投稿一覧グリッド -->
    <% if @posts.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% @posts.each do |post| %>
          <div class="bg-white rounded-lg shadow p-4 hover:shadow-md transition">
            <p class="text-gray-800 mb-2"><%= truncate(post.body, length: 100) %></p>

            <% if post.tags.any? %>
              <div class="mb-2">
                <% post.tags.each do |tag| %>
                  <span class="inline-block px-2 py-1 bg-indigo-100 text-indigo-700 text-xs rounded"><%= tag.name %></span>
                <% end %>
              </div>
            <% end %>

            <% if post.images.any? || post.attached_images.attached? %>
              <div class="text-xs text-gray-500 mb-2">
                📎 画像 <%= post.images.count + post.attached_images.count %>枚
              </div>
            <% end %>

            <div class="text-xs text-gray-400 flex items-center justify-between">
              <span><%= post.user.username %></span>
              <span><%= post.created_at.strftime("%Y/%m/%d %H:%M") %></span>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-12 bg-white rounded-lg shadow">
        <p class="text-gray-500">
          <% if params[:keyword].present? || params[:tag_id].present? %>
            検索条件に一致する投稿が見つかりませんでした
          <% else %>
            まだ投稿がありません。Discord上で「この情報を保存」を実行してみてください。
          <% end %>
        </p>
      </div>
    <% end %>
  </div>
</div>
